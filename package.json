{
  "name": "bailax-studios",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "build:dist": "npm run build && git add -A -f dist",
    "typecheck": "tsc",
    "preview": "vite preview",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@carbon/react": "^1.121.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "sass": "^1.108.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^6.0.6"
  }
}
